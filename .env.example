PLANNER_MODE=fixture
V2_PLANNER_MODE=fixture
MODEL_API_KEY=
# Optional V2 Baseten key; configure only in ignored .env. V1 Baseten dispatch stays disabled.
# V2 requires verified model metadata/counting and explicit shared-accounting migration; see README.
BASETEN_API_KEY=
# Keep the existing operator directory; never initialize another to replenish quotas.
# Meta and Baseten share 3/code, 50 global, US$0.05/proposal and US$2.50 total in v3.
# V2_OPERATOR_DIR=runs/v2-live/operator

# Hosted runtime (opt-in; keep the local defaults above for ordinary development).
# Set the existing V2_PLANNER_MODE to meta for real reviewer use; fixture is CI-only.
# PROOFPATH_RUNTIME=hosted
# PUBLIC_ORIGIN=https://your-reviewer-service.example
# PORT=3000
# FIXTURE_PORT=4173
# DATA_DIR=/var/data/proofpath
# V2_OPERATOR_DIR=/var/data/proofpath/operator
# Hosted Meta requires existing valid app/operator state on the mounted volume.
# Never initialize a new budget to replace consumed capacity or recover lost state.
