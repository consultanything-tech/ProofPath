{
  "name": "proofpath",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "pnpm build && node --env-file-if-exists=.env dist/src/server.js",
    "test": "pnpm build && node --test dist/tests/*.test.js",
    "test:safety": "pnpm build && node --test dist/tests/safety.integration.js",
    "test:ui": "pnpm build && node --test dist/tests/ui.integration.js",
    "test:v2": "pnpm build && node --test dist/tests/v2-*.test.js",
    "test:v2:browser": "pnpm build && node --test --test-concurrency=1 dist/tests/v2-browser.integration.js dist/tests/v2-ui.integration.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "^1.57.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
