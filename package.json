{
  "name": "proofpath",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "pnpm build && node --env-file-if-exists=.env dist/src/server.js",
    "operator:v2:init": "pnpm build && node dist/src/v2-operator.js init",
    "test": "pnpm build && node --test dist/tests/*.test.js",
    "test:safety": "pnpm build && node --test dist/tests/safety.integration.js",
    "test:deployment": "pnpm build && node --test --test-concurrency=1 dist/tests/hosted-runtime.test.js dist/tests/container-packaging.test.js dist/tests/hosted-browser.integration.js",
    "test:ui": "pnpm build && node --test dist/tests/ui.integration.js",
    "test:v2": "pnpm build && node --test dist/tests/v2-*.test.js",
    "test:v2:browser": "pnpm build && node --test --test-concurrency=1 dist/tests/v2-browser.integration.js dist/tests/v2-ui.integration.js dist/tests/v2-controlled.integration.js dist/tests/v2-baseten-controlled.integration.js",
    "typecheck": "tsc --noEmit",
    "operator:v2:init-shared": "pnpm build && node dist/src/v2-operator-v3.js init",
    "operator:v2:migrate-shared": "pnpm build && node dist/src/v2-operator-v3.js migrate",
    "baseten:preflight": "pnpm build && node --env-file-if-exists=.env dist/src/v2-baseten-preflight.js"
  },
  "dependencies": {
    "playwright": "^1.57.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
